# App Configuration
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_TELEMETRY_DISABLED=1

# Session & Authentication
SESSION_COOKIE_NAME="app_session"
SESSION_DURATION_DAYS=15
AUTH_SECRET="your-64-character-hex-auth-secret"
ADMIN_TOTP_SECRET="your-base32-totp-secret"

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?sslmode=require"

# S3 Object Storage (AWS S3, Cloudflare R2, Neon, etc.)
S3_ENDPOINT="https://s3.region.amazonaws.com"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
S3_REGION="ap-southeast-1"
S3_BUCKET="your-bucket-name"
NEXT_PUBLIC_S3_URL="https://cdn.yourdomain.com"

